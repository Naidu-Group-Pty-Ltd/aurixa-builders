idx ai_spend_budgets CREATE UNIQUE INDEX ai_spend_budgets_pkey ON public.ai_spend_budgets USING btree (agent_key, period_month)
idx ai_spend_reservations CREATE INDEX ai_spend_reservations_open_idx ON public.ai_spend_reservations USING btree (agent_key, period_month, created_at) WHERE (state = 'open'::text)
idx ai_spend_reservations CREATE UNIQUE INDEX ai_spend_reservations_pkey ON public.ai_spend_reservations USING btree (id)
