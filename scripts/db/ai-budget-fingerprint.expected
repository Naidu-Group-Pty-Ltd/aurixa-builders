fn ai_budget_reserve(p_agent_key text, p_amount_micros bigint, p_cap_micros bigint, p_model_id text, p_route text) md5=fb13ad41258cccb6857f36221fb40c1a secdef=true config=search_path=public volatile=v
fn ai_budget_settle(p_reservation_id uuid, p_actual_micros bigint) md5=645a52beeae10fdec9f180698e7842bd secdef=true config=search_path=public volatile=v
fn ai_budget_status(p_agent_key text) md5=6160fbb84f4169e019c7b88cb91c5e64 secdef=true config=search_path=public volatile=s
fn-acl ai_budget_reclaim_expired(p_agent_key text, p_period date, p_older_than interval) service_role:EXECUTE
fn-acl ai_budget_release(p_reservation_id uuid) service_role:EXECUTE
fn-acl ai_budget_reserve(p_agent_key text, p_amount_micros bigint, p_cap_micros bigint, p_model_id text, p_route text) service_role:EXECUTE
fn-acl ai_budget_settle(p_reservation_id uuid, p_actual_micros bigint) service_role:EXECUTE
