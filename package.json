{
  "name": "aurixa-builders",
  "private": true,
  "version": "0.1.0",
  "description": "Aurixa Builders Network — the central multi-vendor Builder Portal at builders.aurixasystems.com.au",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:baseline:build": "node scripts/db/build-baseline.mjs",
    "db:baseline:check": "node scripts/db/baseline-check.mjs",
    "db:media-contract:check": "node --experimental-strip-types --no-warnings scripts/db/media-contract-check.ts",
    "typecheck:edge": "deno check --config supabase/functions/deno.json supabase/functions/builder-*/index.ts",
    "security:portal": "node scripts/portal/security-check.mjs",
    "check:verify-jwt": "node scripts/security/check-verify-jwt-declared.mjs",
    "check:schema-refs": "node scripts/security/check-runtime-schema-refs.mjs",
    "check:rate-limit-coverage": "node scripts/security/check-auth-rate-limit-coverage.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json --noEmit",
    "check:migration-versions": "node scripts/db/check-migration-version-collisions.mjs",
    "check:migration-order": "node --max-old-space-size=4096 scripts/db/check-migration-dependency-order.mjs",
    "ocr:vendor-language": "node scripts/ocr/vendor-language.mjs",
    "ocr:vendor-engine": "node scripts/ocr/vendor-engine.mjs",
    "db:agency-messaging:check": "node scripts/db/agency-messaging-check.mjs"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vercel/node": "^13.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.5.4",
    "deno": "^2.9.6",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.26",
    "tailwindcss": "3.4.19",
    "tinyglobby": "^0.2.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.19",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@simplewebauthn/browser": "10",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.37.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  }
}
